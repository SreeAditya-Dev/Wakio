# ============================================================
#  Wakio — Scan-to-Stop Alarm — FastAPI backend environment
#  Copy to `.env` and fill in real values.
# ============================================================

# --- App ---
APP_NAME="Wakio API"
ENVIRONMENT=development            # development | production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["*"]         # tighten in production

# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Project Settings -> API -> JWT Settings -> JWT Secret
# IMPORTANT: FastAPI signs tokens with THIS secret so the same token also
# authorizes Supabase Realtime + Storage (RLS keyed to auth.uid()).
SUPABASE_JWT_SECRET=YOUR-SUPABASE-JWT-SECRET
SUPABASE_STORAGE_BUCKET=sounds

# --- Supabase Storage (S3 protocol) ---
# Project Settings -> Storage -> S3 Connection
SUPABASE_S3_ENDPOINT=https://YOUR-PROJECT.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR-REGION
SUPABASE_S3_ACCESS_KEY_ID=YOUR-S3-ACCESS-KEY-ID
SUPABASE_S3_SECRET_ACCESS_KEY=YOUR-S3-SECRET-ACCESS-KEY

# --- Database ---
# Supabase: Project Settings -> Database -> Connection string (URI, "Direct connection")
# Use the async driver. For local dev via docker-compose use the LOCAL line.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alarm
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=YOUR-WEB-OR-ANDROID-CLIENT-ID.apps.googleusercontent.com

# --- Object detection ---
YOLO_MODEL_PATH=app/ml/weights/yolo11n.pt
YOLO_CONFIDENCE=0.45
